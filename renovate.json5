{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "group:allNonMajor"],
  // Ecosystems are enabled one at a time; see docs/renovate.md.
  enabledManagers: ["github-actions", "custom.regex", "helmv3", "argocd"],
  customManagers: [
    {
      // The Renovate CLI version pinned in .github/workflows/renovate.yaml.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/renovate\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+RENOVATE_VERSION: \"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
  argocd: {
    // The Argo CD Applications for external charts.
    managerFilePatterns: ["/^charts/argocd-applications/templates/.+\\.yaml$/"],
  },
  packageRules: [
    {
      // CI requires charts/*/rendered.yaml to match build.sh. build.sh renders every
      // chart, so first fetch the dependencies of all of them, as helm-setup does.
      matchManagers: ["helmv3", "argocd"],
      postUpgradeTasks: {
        commands: [
          "ci-tools/helm-add-repos.sh",
          "ci-tools/helm-update-all.sh",
          "./build.sh",
        ],
        fileFilters: ["charts/*/rendered.yaml"],
        executionMode: "branch",
      },
    },
    {
      // Terraform installs these from their local paths and upgrades the release only
      // when the chart version changes.
      matchManagers: ["helmv3"],
      matchFileNames: ["charts/argocd/Chart.yaml", "charts/cilium/Chart.yaml"],
      bumpVersion: "patch",
    },
  ],
}
